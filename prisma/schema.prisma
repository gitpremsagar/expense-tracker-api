// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid()) @map("_id")
  name          String
  email         String         @unique
  password      String
  userType      UserType
  refreshTokens RefreshToken[]
  categories     Category[]
  categoryGroups CategoryGroup[]
  transactions  Transaction[]
  debts         Debt[]
  debtPayments  DebtPayment[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  assistantUsage         AssistantUsageLog[]
  assistantPreference    AssistantPreference?
  assistantRequests      AssistantRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid()) @map("_id")
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid()) @map("_id")
  name         String
  type         CategoryType
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@index([groupId])
}

model CategoryGroup {
  id         String       @id @default(cuid()) @map("_id")
  name       String
  type       CategoryType
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id         String       @id @default(cuid()) @map("_id")
  amount     Float
  note       String?
  type       CategoryType
  date       DateTime
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([categoryId])
}

enum UserType {
  ADMIN
  CUSTOMER
}

enum CategoryType {
  INCOME
  EXPENSE
  SAVING
  INVESTMENT
}

enum DebtType {
  TAKEN
  GIVEN
}

model Debt {
  id          String        @id @default(cuid()) @map("_id")
  type        DebtType
  partyName   String
  amount      Float
  description String?
  date        DateTime
  status      String
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments    DebtPayment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
}

model DebtPayment {
  id        String   @id @default(cuid()) @map("_id")
  amount    Float
  date      DateTime
  note      String?
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debtId])
  @@index([userId])
}

// ─── Assistant ────────────────────────────────────────────────────────────────

model AssistantConversation {
  id            String             @id @default(cuid()) @map("_id")
  title         String             @default("New chat")
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AssistantMessage[]
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, lastMessageAt])
}

model AssistantMessage {
  id             String                @id @default(cuid()) @map("_id")
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  content        String
  payload        Json?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([userId])
}

model AssistantUsageLog {
  id               String   @id @default(cuid()) @map("_id")
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?
  model            String
  intent           String?
  proposalCount    Int      @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model AssistantPreference {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoSave  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssistantRequest {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  kind      String
  result    Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

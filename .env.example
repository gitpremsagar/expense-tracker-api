# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="mongodb://localhost:27017/money-tracker-365"

JWT_ACCESS_SECRET="change-me-at-least-16-characters"
JWT_REFRESH_SECRET="change-me-at-least-16-characters"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3710

# Reporting calendar timezone
APP_TIMEZONE="Asia/Kolkata"

# Password reset email (optional in development; required in production)
PASSWORD_RESET_TTL_MINUTES=60
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Money Tracker 365 <no-reply@your-domain>"

# Admin seed is a planned feature; see docs/.
# ADMIN_SEED_EMAIL="you@example.com"
# ADMIN_SEED_PASSWORD="a-strong-password"

# AI assistant (DeepSeek). Without a key the app works normally and
# /assistant/* returns a friendly 503.
# DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
ASSISTANT_ENABLED="true"
ASSISTANT_THINKING_DEFAULT="false"
ASSISTANT_REASONING_EFFORT_DEFAULT="high"
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_IMPORT_TIMEOUT_MS=120000
ASSISTANT_MAX_TEXT_CHARS=2000
ASSISTANT_MAX_CREATES_PER_TURN=10
ASSISTANT_DAILY_MESSAGES=100
ASSISTANT_DAILY_IMPORT_PAGES=50
ASSISTANT_MAX_IMPORT_ROWS=500
ASSISTANT_MAX_IMAGE_MB=10
ASSISTANT_MAX_AUDIO_MB=8
ASSISTANT_MAX_STATEMENT_MB=20
ASSISTANT_GLOBAL_DAILY_COST_USD=10
